# HARD RULE: the baserom must NEVER be committed.
baserom.gba
frog_us_baserom.gba
*_baserom.gba

# Build outputs
/src/**/*.s
/data/*
/sound/direct_sound_samples/*

*.gba
*.elf
*.dump
*.o
*.map
*.bin
*.sav

# Windows/.NET tool detritus
*.exe
*.dll
*.deps.json
*.runtimeconfig.json

# Generated files
linker.ld.pp
include/**/*.s
tools/*.txt
# agbcc is treated as a system/local dependency, not vendored.
# - tools/agbcc-src/ is the local clone of pret/agbcc (build it once per machine)
# - tools/agbcc/ is the installed bin/include/lib tree the Makefile consumes
tools/agbcc/
tools/agbcc-src/
tools/agent/bin/
tools/agent/.function_addresses.json
tools/agent/.progress_sheet.csv
tools/agent/.rename_manifest.json

# Scratch / nonmatching exploration
.scratch/
nonmatchings/
.permuter_staging/

# tools/agent/build_expected.py output — regenerate any time with:
#   python3 tools/agent/build_expected.py --clean
expected/

# IDE / OS
.vscode
.DS_Store
.idea/

# Claude Code harness state (loop / schedule lock files, worktrees, etc.) —
# but keep the project's reusable agent workflows under source control.
.claude/*
!.claude/workflows/

# Logs
err.log
tools/agent/__pycache__/
**/__pycache__/
*.pyc

# Node / TypeScript agent tooling
node_modules/
tools/agent/ts/**/*.js
tools/agent/ts/**/*.d.ts
tools/agent/ts/**/*.js.map

# m2c / decomp-permuter installed venvs (vendored sources are git submodules — venvs are local-only)
vendor/m2c/.venv/
vendor/decomp-permuter/.venv/
~/.cache/mizuchi/

# tools/agent/corpus.py cache (other agbcc-era GBA decomps, never committed).
# Lives under $HOME/.cache/decomp-corpus by default — this pattern is
# defensive in case someone points DECOMP_CORPUS_DIR at a path inside the
# repo.
.cache/decomp-corpus/
decomp-corpus/

# Full git mirrors (blobs present) for corpus_asm_search.py's history search.
# ~1.4G of other agbcc-era decomp repos — NEVER committed. Populate with
# `python3 tools/agent/corpus_asm_search.py sync --from <path-to-mirrors>`.
# No trailing slash: worktree bootstraps SYMLINK this path, and a dir-only
# pattern ("…/") wouldn't match the symlink, leaving it as untracked noise
# that trips the workflow's clean-tree check.
tools/agent/corpus-mirrors
